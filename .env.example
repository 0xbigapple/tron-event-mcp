# MongoDB connection (strongly recommended to use a read-only user)
# mongodb://readonly_user:password@host:27017/dbname?authSource=admin
MONGO_URI=mongodb://localhost:27017

# Database name
MONGO_DB=tron

# Maximum documents per query (prevents LLM from fetching massive datasets)
MAX_RESULT_LIMIT=500

# Query timeout in milliseconds
QUERY_TIMEOUT_MS=10000

# SSE transport settings (only effective when MCP_TRANSPORT=sse)
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# Transport mode: stdio or sse (default: stdio)
# MCP_TRANSPORT=stdio
